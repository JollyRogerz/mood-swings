PORT=3000
# In production, point this at the Postgres service in the same Railway project.
DATABASE_URL=postgresql://user:password@localhost:5432/mood_swings

# Accounts (optional). They switch on when DATABASE_URL and BETTER_AUTH_SECRET
# are both set. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public address of the site, without a trailing slash. On Railway this is
# worked out from RAILWAY_PUBLIC_DOMAIN when left empty.
BETTER_AUTH_URL=
# Each sign-in button appears only when both of its values are set.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development and tests only: accounts kept in memory, lost on restart.
# MOOD_ACCOUNTS=memory

# Optional private deck-photo reviewers: stable profile user IDs, not usernames.
# Leave unset for automatic Photo provided badges without manual reviewers.
# MOOD_REVIEWER_IDS=
